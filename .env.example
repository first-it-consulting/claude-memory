# Copy to .env (same directory as compose.yaml) and fill in real values.
# docker compose reads .env automatically. Never commit the result.

# REQUIRED. Bootstrap admin token - creates tenants and mints personal tokens.
# Generate a long random string, e.g.: openssl rand -hex 32
ADMIN_TOKEN=

# Optional LEGACY shared token (tenant "default", role user). Leave empty to
# disable that auth path; personal tokens (POST /api/me/tokens) are preferred
# for everything that can send one. Set this only if you run claude-memory-ui
# without Keycloak - the UI proxy then injects this shared token.
BEARER_TOKEN=

# Postgres password. The db port is NOT published to the host, so the dev
# default is acceptable here; change it if you ever publish 5432.
POSTGRES_PASSWORD=mem0

# Host port the server is reachable on.
APP_PORT=8080

# Ollama is required for real use: embeddings are needed for every write and
# search; the chat model is used when memories are stored with infer=true.
# From inside the containers on Docker Desktop use host.docker.internal;
# on a Linux server point this at your Ollama host.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_EMBED_MODEL=nomic-embed-text
