{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.config/agent-memory/memory_hook.py session-start --harness claude",
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.config/agent-memory/memory_hook.py prompt --harness claude",
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.config/agent-memory/memory_hook.py pre-compact --harness claude",
            "timeout": 15
          }
        ]
      }
    ]
  }
}